import socket

COM_PORT = (11-1)
BAUDRATE = 115200


class ComThread:
    def __init__(self, Port=5):
        self.l_serial = None
        self.alive = True
        self.waitEnd = None
        self.port = Port

    def waiting(self):
        if not self.waitEnd is None:
            self.waitEnd.wait();

    def SetStopEvent(self):
        if not self.waitEnd is None:
            self.waitEnd.set();
        self.alive = False;
        self.stop();

    def start(self):
        self.l_serial = serial.Serial();
        print self.l_serial.portstr;
        self.l_serial.port = self.port;
        self.l_serial.baudrate = 9600;
        self.l_serial.timeout = 0.1;
        self.l_serial.close();
        self.l_serial.open();
        print self.l_serial.portstr;

        if self.l_serial.isOpen():
            self.waitEnd = threading.Event();
            self.alive = True;
            self.thread_read = None;
            self.thread_read = threading.Thread(target=self.FirstReader);
            self.thread_read.setDaemon(1);
            self.thread_read.start();
            
            return True;
        else:
            return False;

    def FirstReader(self):
        while self.alive:
            #receive interval
            time.sleep(0.1);
            try:
                #data = raw_input();
                #print 'input data from keyboard:',data;
                strSerial = "abc"
                strHex = binascii.b2a_hex(strSerial)
          #      print strHex
                strhex = strHex.decode("hex")
          #      print strhex
          #      self.l_serial.write(strhex);
                
                n = self.l_serial.inWaiting();
         #       print 'n=',n
                data = '';
                if n:
                    data = '';
                    data = self.l_serial.read(100);
                    print 'get data from serial port:',data;
                    time.sleep(3);
                    #break;

                # 判断结束
                if len(data) > 0 and ord(data[len(data)-1])==0x45:
                    #pass;
                    break;
               
            except Exception, ex:
                print str(ex);

        self.waitEnd.set();
        self.alive = False;

    def stop(self):
        self.alive = False;
        self.thread_read.join();
        if self.l_serial.isOpen():
            self.l_serial.close();


def at_command(arg):
 #   print arg
    print '>:',arg;
  #  print '';
    l_serial = serial.Serial();
 #   print l_serial.portstr;
    l_serial.port = COM_PORT;
    l_serial.baudrate = BAUDRATE;
    l_serial.timeout = 0.1;
    l_serial.close();
    l_serial.open();
  #  print l_serial.portstr;
    l_serial.write(arg);
    time.sleep(0.2);
    data = l_serial.read(100);
    print '<:',data;
 #   print '';
    l_serial.close();


def Discovery(arg):
    print arg
    found=0;
    l_serial = serial.Serial();
    #print l_serial.portstr;
    for baud in [9600,9600,57600,115200,38400,19200,4800,14400,600,300,110,2400,1200]:
        l_serial.port = arg;
        l_serial.baudrate = baud;
        l_serial.timeout = 0.1;
        l_serial.close();
        l_serial.open();
        #print l_serial.portstr;
        print 'testing ...',l_serial.portstr,' ',baud;
        l_serial.write('at\r\n');
        time.sleep(0.2);
        data = l_serial.read(100);
        print 'get data from serial port:',data;
        print ''
        print 'get data from serial port:END';
        l_serial.close();
        if(data == 'at\r\n'):
            found=1;
            break;

    if(found == 1):
        print 'Discovery found!!!: ',l_serial.portstr,' ',baud;
    else:
        print 'Discovery failed!!! ';
    
    return(baud)


HOST = '192.168.11.255' 
PORT = 988
BUFSIZ = 1024 
ADDR = (HOST, PORT)

UDP_TIMEOUT = 5

def time_1():
    time.sleep(1);
    if(0 != UDP_TIMEOUT):
        UDP_TIMEOUT -= 1;

def UDP_Discovery():
    global ADDR
    global BUFSIZ
    global UDP_TIMEOUT
    udpCliSock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    #udpCliSock.setblocking(0)
    udpCliSock.settimeout(3)
    udpCliSock.sendto('HLK', ADDR)
    UDP_TIMEOUT = 2
    print "----------------------------------"
    while 1:
        try:
            data,ADDR = udpCliSock.recvfrom(BUFSIZ)
            print ADDR[0],':',data
        except socket.error, e:   
            print "----------------------------------"
            print 'Error receiving data:%s' % e
            break;
   #     time.sleep(1);
  #      UDP_TIMEOUT -= 1;
    udpCliSock.close();
  

def UDP_AT(ip, command ):
    global PORT
    global BUFSIZ
    global UDP_TIMEOUT
    ADDR = (ip, PORT);
    udpCliSock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    #udpCliSock.setblocking(0)
    udpCliSock.settimeout(1)
    udpCliSock.sendto("HJ^&%$#(7854462cdEcEOl"+command, ADDR)
    print "----------------------------------"
    while 1:
        try:
            data,ADDR = udpCliSock.recvfrom(BUFSIZ)
            print ADDR[0],':',data
        except socket.error, e:   
            print "----------------------------------"
            print 'Error receiving data:%s' % e
            break;
   #     time.sleep(1);
  #      UDP_TIMEOUT -= 1;
  
def AT_all_net(command ):
    UDP_AT('192.168.11.255',command);

def show_menu():
    print "---------------------------------------------------"
    print "0. COM Setting."
    print "1. Discovery."
    print "2. eth. dhcp."
    print "3. wifi Client.dhcp."
    print "4. wifi AP."
    print "5. tcp client."
    print "6. tcp server."
    print "7. udp client."
    print "8. udp server."
    print "9. data loop."
    print "q. exit."

def getchar(xx):
    '''
    Equivale al comando getchar() di C
    '''

    print xx
    import msvcrt
    ch = msvcrt.getch();
#    print ch
 #   ch = raw_input(xx);
    return(ch)

def serial_send(value ):
    l_serial = serial.Serial();
    #print l_serial.portstr;
    for baud in [115200]:
        l_serial.port = 10;
        l_serial.baudrate = baud;
        l_serial.timeout = 0.1;
        l_serial.close();
        l_serial.open();
        #print l_serial.portstr;
        print 'testing ...',l_serial.portstr,' ',baud;
        l_serial.timeout=10;
        datax = l_serial.read(5);
        print datax;
        l_serial.write(value);
        l_serial.close();
        
    return(baud)

  
    
