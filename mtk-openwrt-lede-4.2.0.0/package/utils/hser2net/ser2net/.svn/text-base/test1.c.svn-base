/*
 * ioctl commands
 */
#define	RALINK_GPIO_SET_DIR		0x01
#define RALINK_GPIO_SET_DIR_IN		0x11
#define RALINK_GPIO_SET_DIR_OUT		0x12
#define	RALINK_GPIO_READ		0x02
#define	RALINK_GPIO_WRITE		0x03
#define	RALINK_GPIO_SET			0x21
#define	RALINK_GPIO_CLEAR		0x31
#define	RALINK_GPIO_READ_BIT		0x04
#define	RALINK_GPIO_WRITE_BIT		0x05
#define	RALINK_GPIO_READ_BYTE		0x06
#define	RALINK_GPIO_WRITE_BYTE		0x07
#define	RALINK_GPIO_READ_INT		0x02 //same as read
#define	RALINK_GPIO_WRITE_INT		0x03 //same as write
#define	RALINK_GPIO_SET_INT		0x21 //same as set
#define	RALINK_GPIO_CLEAR_INT		0x31 //same as clear
#define RALINK_GPIO_ENABLE_INTP		0x08
#define RALINK_GPIO_DISABLE_INTP	0x09
#define RALINK_GPIO_REG_IRQ		0x0A
#define RALINK_GPIO_LED_SET		0x41


void gpio_init()
{
	int fd, req;

system("reg s 0;reg w 60 00400095");


	fd = open(GPIO_DEV, O_RDONLY);
	if (fd < 0) {
		perror(GPIO_DEV);
		return -1;
	}

	if(ioctl(fd, RALINK_GPIO_SET_DIR_IN, 0xffffffff) < 0){
//	if(ioctl(fd, RALINK_GPIO_SET_DIR_IN, (1<<1)) < 0){

		perror("ioctl");
		TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}
	if(ioctl(fd, RALINK_GPIO_SET_DIR_OUT, (1<<2)) < 0){
		perror("ioctl");
		TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}
		TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	close(fd);
}

uchar gpio_read()
{
	
	int fd, req;

	int value=0;

	gpio_init();

	

	fd = open(GPIO_DEV, O_RDONLY);
	if (fd < 0) {
		perror(GPIO_DEV);
		return -1;
	}
	
	if(ioctl(fd, RALINK_GPIO_READ, &value) < 0){
		perror("ioctl");
	}

	close(fd);

	TIM_DEBUG("in:%s(%d)(%08x)\r\n",__FUNCTION__,__LINE__,value);

	if(value&(1<<1)){
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
		return 0;
	}
	else{
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
		return 1;
	}
}
uchar gpio_set(uchar bit)
{
	
	int fd, req;

	uint value=0;

	fd = open(GPIO_DEV, O_RDONLY);
	if (fd < 0) {
		perror(GPIO_DEV);
		return -1;
	}
	
	if(ioctl(fd, RALINK_GPIO_READ, &value) < 0){
		perror("ioctl");
	}
	
	value &=~(1<<2);
	if(bit)
		value |=(1<<2);

	
	if(ioctl(fd, RALINK_GPIO_WRITE, value) < 0){
		perror("ioctl");
	}

	close(fd);

	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

}


void ser2net_check()
{
	FILE *fp;
	
	static uchar count=0;
//	static int process_id=0;
//	int process_id;
//	process_id=get_ser2net_pid();
	char buf1[128];
	int len;
	
//	sprintf(buf1,"ps|grep \"ser2net\"|grep %d",process_id);
	sprintf(buf1,"ps|grep \"ser2net\"|grep -v \"grep\"");
	if((fp = popen(buf1, "r"))<=0) {
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		return;
	}
	 len = fread(buf1, 1, sizeof(buf1)-1, fp);
	 if(len>=sizeof(buf1)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		pclose(fp);
		return;
	 }
	pclose(fp);

	buf1[len]=0;

	if(strstr(buf1,"ser2net")){
		count=0;
	}
	else{
		if(count<50)
			count++;
	}

	if(count>4){
		system("(killall -q ser2net;killall -q -9 ser2net;sleep 1;ser2net)&");
		count=0;
	}
}



