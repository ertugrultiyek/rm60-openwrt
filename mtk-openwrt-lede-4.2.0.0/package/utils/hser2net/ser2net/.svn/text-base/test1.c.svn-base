#define SER2NET_CFG_DOMAIN "/tmp/SER2NET_CFG_HLK"


#define TIM_DEBUG printf

#define TIM_TRACE() TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__)


uchar config_at(uchar *in,uchar *out)
{
	static struct sockaddr_un srv_addr;
	int connect_fd;
	
	int ret;
	char snd_buf[1024];
	int i;
	
//creat unix socket
	connect_fd=socket(PF_UNIX,SOCK_STREAM,0);
	if(connect_fd<0)
	{
		perror("cannot create communication socket");
		return 1;
	}	
	srv_addr.sun_family=AF_UNIX;
	strcpy(srv_addr.sun_path,SER2NET_CFG_DOMAIN);
//connect server
	ret=connect(connect_fd,(struct sockaddr*)&srv_addr,sizeof(srv_addr));
	if(ret==-1)
	{
		perror("cannot connect to the server");
		close(connect_fd);
		return 1;
	}
	memset(snd_buf,0,1024);
//	strcpy(snd_buf,"message from client");
	strcpy(snd_buf,in);
//send info server
	for(i=0;i<4;i++)
		write(connect_fd,snd_buf,sizeof(snd_buf));
	
//		read(connect_fd,snd_buf,sizeof(snd_buf));
	close(connect_fd);
	return 0;
}



void msg_stat(int msgid,struct msqid_ds msg_info)
{
int reval;
sleep(1);//只是为了后面输出时间的方便
reval=msgctl(msgid,IPC_STAT,&msg_info);
if(reval==-1)
{
    printf("get msg info error\n");
    return;
}
printf("\n");
printf("current number of bytes on queue is %d\n",msg_info.msg_cbytes);
printf("number of messages in queue is %d\n",msg_info.msg_qnum);
printf("max number of bytes on queue is %d\n",msg_info.msg_qbytes);
//每个消息队列的容量（字节数）都有限制MSGMNB，值的大小因系统而异。在创建新的消息队列时，//msg_qbytes的缺省值就是MSGMNB
printf("pid of last msgsnd is %d\n",msg_info.msg_lspid);
printf("pid of last msgrcv is %d\n",msg_info.msg_lrpid);
printf("last msgsnd time is %s", ctime(&(msg_info.msg_stime)));
printf("last msgrcv time is %s", ctime(&(msg_info.msg_rtime)));
printf("last change time is %s", ctime(&(msg_info.msg_ctime)));
printf("msg uid is %d\n",msg_info.msg_perm.uid);
printf("msg gid is %d\n",msg_info.msg_perm.gid);

}




//"115200,8,n,1"
int Serial_Config(int fd,uchar *para)
{

	speed_t speed;

	int Baud=115200;
	uchar Data_size=8;
	uchar parity='n';
	uchar stop_bit=1;

if(fd<0){
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);	
}
	
{
	uchar *p1,*p2,*p3;

p1=para;

if(p1){
	Baud=atoi(p1);
	p2 = strchr(p1,',');
	if(p2){
		p1=(p2+1);
		Data_size=atoi(p1);
		p2 = strchr(p1,',');
		if(p2){
			p1=(p2+1);
			parity=*p1;
			
			p2 = strchr(p1,',');
			if(p2){
				p1=(p2+1);
				stop_bit=atoi(p1);
			}
		}
	}
}


}

	TIM_DEBUG("In:%s(%d) (%d)(%d)(%c)(%d)\r\n",__FUNCTION__,__LINE__,
		Baud,Data_size,parity,stop_bit);

	tcgetattr(fd,&oldtio);
    	tcgetattr(fd,&options);   

	TIM_DEBUG("In:%s(%d)(%d)(%d)\r\n",__FUNCTION__,__LINE__,cfgetospeed(&options),cfgetospeed(&oldtio));

   	fcntl(fd,F_SETFL,0);
	fcntl(fd,F_SETFL,FNDELAY) ;
   	
	//options.c_cflag&=~PARENB;
	//options.c_cflag&=~CSTOPB;
	//options.c_cflag&=~CSIZE;
	//options.c_cflag|=CS8;
	//options.c_lflag=0;
	//options.c_oflag&=(~OPOST);
	//options.c_cflag|=(CLOCAL|CREAD);
	//options.c_cc[VTIME]    = 20;  /* inter-character timer use 2s */
	//options.c_cc[VMIN]     = 0;   /* blocking read until 1 chars received */

       //Add by Ls 20031115   以原始流的方式打开串口,不做任何其他转化
	//options.c_lflag  &= ~(ICANON | ECHO | ECHOE | ISIG);  /*Input*/
	//options.c_oflag  &= ~OPOST;   /*Output*/

	options.c_iflag = 0;
	options.c_oflag = 0;
	options.c_lflag = 0;
	if(0==0)  
		options.c_cc[VTIME]    = 20;
	else  
		options.c_cc[VTIME]    = 0;//20;  //inter-character timer use 2s 
//	options.c_cc[VTIME]    = 20;
	options.c_cc[VMIN]     = 0;   //blocking read until 1 chars received 
	options.c_cflag = CS8 | CLOCAL | CREAD;


	
if(5 == Data_size){
	options.c_cflag &= ~CSIZE;
	options.c_cflag |= CS5;

}
else if(6 == Data_size){
	options.c_cflag &= ~CSIZE;
	options.c_cflag |= CS6;

}
else if(7 == Data_size){
	options.c_cflag &= ~CSIZE;
	options.c_cflag |= CS7;

}
else if(8 == Data_size){
	
	options.c_cflag &= ~CSIZE;
	options.c_cflag |= CS8;

}


if('n' == parity){

}
else if('o' == parity){
	
	options.c_cflag |= PARENB;
	options.c_cflag |= PARODD;
	options.c_iflag |= (INPCK | ISTRIP);

}
else if('e' == parity){
	options.c_cflag |= PARENB;
	options.c_cflag &= ~PARODD;
	options.c_iflag |= (INPCK | ISTRIP);
}

	
if(0 == stop_bit){
	options.c_cflag &= ~CSTOPB;
}
else if(1 == stop_bit){
	options.c_cflag |= CSTOPB;
}

	
	switch(Baud){
		case 50:
			speed=B50;
			break;
		case 75:
			speed=B75;
			break;
		case 110:
			speed=B110;
			break;
		case 134:
			speed=B134;
			break;
		case 150:
			speed=B150;
			break;
		case 200:
			speed=B200;
			break;
		case 300:
			speed=B300;
			break;
		case 600:
			speed=B600;
			break;
		case 1200:
			speed=B1200;
			break;
		case 1800:
			speed=B1800;
			break;
		case 2400:
			speed=B2400;
			break;
		case 4800:
			speed=B4800;
			break;
		case 9600:
			speed=B9600;
			break;
		case 19200:
			speed=B19200;
			break;
		case 38400:
			speed=B38400;
			break;
		case 57600:
			speed=B57600;
			break;
		case 115200:
			speed=B115200;
			break;
		case 230400:
			speed=B230400;
			break;
		default:
			speed=B115200;
			TIM_WARN("WARN:%s(%d)\r\n",__FUNCTION__,__LINE__);
			break;
	}
	
	TIM_DEBUG("in:%s(%d) %d %d %d\r\n",__FUNCTION__,__LINE__,B115200,speed,B57600);

	TIM_DEBUG(":%s(%d)(%d)(%d)\r\n",__FUNCTION__,__LINE__,cfgetospeed(&options),cfgetospeed(&oldtio));

	
//	cfsetospeed(&options,speed);
//	cfsetispeed(&options,speed);
	if(cfsetispeed(&options,speed)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	
	if(cfsetispeed(&options,speed)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	

	if(tcsetattr(fd,TCSAFLUSH,&options)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	

	tcflush(fd,TCIOFLUSH); 
	return 0;
}

#define UART_DEV "/dev/ttyS1"

void serial_test()
{
	int g_serial_fd=0;
	
		g_serial_fd=open(UART_DEV,O_RDWR|O_NOCTTY|O_NDELAY);

	if(g_serial_fd<0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		close(g_serial_fd);
		return;
	}

	
TIM_DEBUG("in:%s(%d) %d\r\n",__FUNCTION__,__LINE__,g_serial_fd);

	Serial_Config(g_serial_fd,"110,8,n,1");
	
{
	uchar buf[1024*8];
	uint ret;
	memset(buf,'1',sizeof(buf));
	ret = write(g_serial_fd, buf, 1);	 //
	
TIM_DEBUG("in:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,sizeof(buf),ret);

}
	close(g_serial_fd);
}

void time_now()
{
	struct timeval tv;
	gettimeofday (&tv , NULL);
	printf("tv_sec; %d\n", tv.tv_sec) ;
	printf("tv_usec; %d\n",tv.tv_usec);
}


#define KEY "H@L9K*(343jkdf98325&%*((&532234566xdetr09sdfkw3njxci83027%^&^^%7"

//#define get_key(x) (KEY+((x%7)))
#define get_key(x) (KEY)

void Decrypt(uchar *data,uint len)
{
	uint i;
	uchar *p;
	
	p=data+3;
	for(i=0;i<((len-3)/8);i++){
		Lib_DES(p,get_key(i),0);
		p+=8;
	}
	
	p=data;
	for(i=0;i<(len/8);i++){
		Lib_DES(p,get_key(i),0);
		p+=8;
	}
}
void Encrypt(uchar *data,uint len)
{
	uint i;
	uchar *p=data;
	for(i=0;i<(len/8);i++){
		Lib_DES(p,get_key(i),1);
		p+=8;
	}
	
	p=data+3;
	for(i=0;i<((len-3)/8);i++){
		Lib_DES(p,get_key(i),1);
		p+=8;
	}
}

void printf_hex(uchar *p,uint len)
{
	uint i;
	TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__);
	for(i=0;i<len;i++){
		TIM_DEBUG("%02x ",p[i]);
	}
	TIM_DEBUG("\r\n",__FUNCTION__,__LINE__);
}

void Encrypt_test()
{
 uchar xx[1024*500];

	s_DesInit();


 
	memset(xx,0,sizeof(xx));

	printf_hex(xx,20);

	
	TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__);
	time_now();
	Encrypt(xx,sizeof(xx));
	TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__);
	printf_hex(xx,20);
	TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__);
	time_now();
	Decrypt(xx,sizeof(xx));
	time_now();
	TIM_DEBUG("In:%s(%d)\r\n",__FUNCTION__,__LINE__);
	printf_hex(xx,20);
	
}


