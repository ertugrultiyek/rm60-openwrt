noauth
user 'pppoe_user'
password 'pppoe_passwd'
hide-password
noipdefault
defaultroute
nodetach
usepeerdns
persist
ipcp-accept-remote
ipcp-accept-local
lcp-echo-failure 10
lcp-echo-interval 30
ktune
default-asyncmap nopcomp noaccomp
novj nobsdcomp nodeflate
plugin /etc_ro/ppp/plugins/rp-pppoe.so eth2.2
