    ping = CPing( ipList )
    ping.Ping( )
 #   print 'not connected:'
 #   while not queue.empty( ):
  #      print queue.get( )
    print 'connected:'
    thread_pool = []
    nSum = 0
    while not queue2.empty( ):
        ip=queue2.get( )
        #update_ip(ip)
       # print ip,' cccc....'
        th = threading.Thread(target=update_ip,args=(ip,)) ;
        thread_pool.append(th)
        nSum += 1
        th.start( )
        time.sleep(1);

    
    for i in range(nSum):
        thread_pool[i].join( )
        
    winsound.PlaySound('finish.wav',winsound.SND_FILENAME|winsound.SND_NOWAIT)
    execCmd('arp -d')


