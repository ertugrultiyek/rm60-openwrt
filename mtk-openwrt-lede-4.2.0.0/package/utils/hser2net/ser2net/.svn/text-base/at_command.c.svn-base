uchar AT_remoteip(uchar* comm,uchar*out)
{
	uint ret=0;
	
	if('?' == *(comm+1)){
		sprintf(out,"%s",g_remoteip_domain);
	}
	else if('=' == *(comm+0)){
//		sprintf(REMOTE_IP_BUF,comm+1);
//		g_remoteip_domain=REMOTE_IP_BUF;
		
		g_remoteip_domain = at_set_value_(g_remoteip_domain,comm+1);
		sprintf(out,"ok");
	}
	else{
		sprintf(out,"error");
	}

	return ret;
}

