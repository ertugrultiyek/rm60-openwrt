//=?
uchar AT_version(uchar* comm,uchar*out)
{
	if('?' == *(comm+1)){
		sprintf(out,"V%d.%d(%s)",AT_VERSION/100,AT_VERSION%100,__DATE__);
	}
}

uchar AT_mode(uchar* comm,uchar*out)
{
	uint ret=0;
	
	if('?' == *(comm+1)){
		if(1 == g_network_mode){
			sprintf(out,"server");
		}
		else if(2 == g_network_mode){
			sprintf(out,"client");
		}
		else {
			sprintf(out,"none");
		}
	}
	else if('=' == *(comm+0)){
		uchar *p;
		if(strstr(comm,"server")){
			g_network_mode=1;
			sprintf(out,"ok");
		}
		else if(strstr(comm,"client")){
			g_network_mode=2;
			sprintf(out,"ok");
		}
		else if(strstr(comm,"none")){
			g_network_mode=0;
			sprintf(out,"ok");
		}
		else {
			sprintf(out,"error");
		}
	}

	return ret;
}

