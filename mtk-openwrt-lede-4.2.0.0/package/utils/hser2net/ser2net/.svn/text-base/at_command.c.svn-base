uchar AT_RNoti(uchar* comm,uchar*out)
{
	uint ret=0;
	
	if('?' == *(comm+1)){
		sprintf(out,"%s",nvram_get(SER2NET_NVRAM,"RNoti"));
		if(!strcmp(out,"")){
			sprintf(out,"0");
