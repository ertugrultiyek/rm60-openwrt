#define T(a) a


typedef union _MACHTTRANSMIT_SETTING {
	struct  {
		unsigned short  MCS:7;  // MCS
		unsigned short  BW:1;   //channel bandwidth 20MHz or 40 MHz
		unsigned short  ShortGI:1;
		unsigned short  STBC:2; //SPACE
		unsigned short	eTxBF:1;
		unsigned short	rsv:1;
		unsigned short	iTxBF:1;
		unsigned short  MODE:2; // Use definition MODE_xxx.
	} field;
	unsigned short      word;
} MACHTTRANSMIT_SETTING;


typedef struct _RT_802_11_MAC_ENTRY {
#if 1 //def CONFIG_RT2860V2_AP_V24_DATA_STRUCTURE
	unsigned char			ApIdx;
#endif
	unsigned char           Addr[6];
	unsigned char           Aid;
	unsigned char           Psm;     // 0:PWR_ACTIVE, 1:PWR_SAVE
	unsigned char           MimoPs;  // 0:MMPS_STATIC, 1:MMPS_DYNAMIC, 3:MMPS_Enabled
	char                    AvgRssi0;
	char                    AvgRssi1;
	char                    AvgRssi2;
	unsigned int            ConnectedTime;
	MACHTTRANSMIT_SETTING	TxRate;
	unsigned int			LastRxRate;
#if 1
	int					StreamSnr[3];
	int					SoundingRespSnr[3];
#else
	short					StreamSnr[3];
	short					SoundingRespSnr[3];
#endif
#if 0
	short					TxPER;
	short					reserved;
#endif
} RT_802_11_MAC_ENTRY;

#if	defined (RT2860_WAPI_SUPPORT) || defined (RTDEV_WAPI_SUPPORT)
#define MAX_NUMBER_OF_MAC               96
#else
#define MAX_NUMBER_OF_MAC               32 // if MAX_MBSSID_NUM is 8, this value can't be larger than 211
#endif

typedef struct _RT_802_11_MAC_TABLE {
	unsigned long            Num;
	RT_802_11_MAC_ENTRY      Entry[MAX_NUMBER_OF_MAC]; //MAX_LEN_OF_MAC_TABLE = 32
} RT_802_11_MAC_TABLE;

		
uchar AT_RapStatus(uchar* comm,uchar*out)
{
	uint ret=0;
	
	if('?' == *(comm+1)){

		sprintf(out,"");

do{
	int i, s;
	struct iwreq iwr;
	RT_802_11_MAC_TABLE table = {0};

	s = socket(AF_INET, SOCK_DGRAM, 0);
	strncpy(iwr.ifr_name, "ra0", IFNAMSIZ);
	iwr.u.data.pointer = (caddr_t) &table;

	if (s < 0) {
TIM_ERROR("ERROR:%s(%d) \r\n",__FUNCTION__,__LINE__);
		break;
	}

	if (ioctl(s, RTPRIV_IOCTL_GET_MAC_TABLE_STRUCT, &iwr) < 0) {
TIM_ERROR("ERROR:%s(%d) \r\n",__FUNCTION__,__LINE__);

		close(s);
		break;
	}

	close(s);

	for (i = 0; i < table.Num; i++) {
		uchar bufff[128];
		sprintf(bufff, T("%02X:%02X:%02X:%02X:%02X:%02X "),
				table.Entry[i].Addr[0], table.Entry[i].Addr[1],
				table.Entry[i].Addr[2], table.Entry[i].Addr[3],
				table.Entry[i].Addr[4], table.Entry[i].Addr[5]);
		strcat(out,bufff);
		sprintf(bufff, T("%d %d %d "),
				table.Entry[i].Aid, table.Entry[i].Psm, table.Entry[i].MimoPs);
		strcat(out,bufff);
		sprintf(bufff, T("%d %s %d %d\r\n"),
				table.Entry[i].TxRate.field.MCS,
				(table.Entry[i].TxRate.field.BW == 0)? "20M":"40M",
				table.Entry[i].TxRate.field.ShortGI, table.Entry[i].TxRate.field.STBC);
		strcat(out,bufff);
	}
}while(0);

	}
	else if('=' == *(comm+0)){
		sprintf(out,"error");
	}
	else{
		sprintf(out,"error");
	}

	return ret;
}

