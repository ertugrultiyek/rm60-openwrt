			static uchar x=0;
			static uint lasttime=0;
			if(lasttime){     
				struct  timeval    tv;
				gettimeofday(&tv,NULL);
				if(lasttime == tv.tv_sec){
					x++;
					if(x>5){
						TIM_ERROR("ERROR:%s(%d)reboot\r\n",__FUNCTION__,__LINE__);
