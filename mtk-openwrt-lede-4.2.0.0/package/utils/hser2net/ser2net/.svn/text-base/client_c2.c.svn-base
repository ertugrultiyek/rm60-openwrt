void * C2_ser2network_client_thread(void * arg)
{
	uchar first_run=1;
	uchar connected=0;
	uchar remote_closed=0;
	int ret;
	
	uint rx_need_wait=0;
	struct timeval rx_need_wait_start; 
	
	//int g_network_fd=0;
	int g_select_quit_fd=0;
	int g_notify_socket_fd=0;
	
	struct timeval tv; 
	fd_set select_fds;

	int 		  sockfd=0, maxfd, maxi, i;
	struct sockaddr_in their_addr;

	ssize_t   n;			 //!> read字节数
	uchar	   buf[SERIAL_BUF_LEN]; 		
//	uchar	   buf_serial[SERIAL_BUF_LEN];	
	uint buf_serial_len=0;

//	uint serial_timeout=0;
	
	struct hostent *he;
	
	led_set(0);

							
	C2_ERROR_TIMES_RESET();
again1: 
	if((mkfifo(CLIENT_QUIT_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_select_quit_fd = open(CLIENT_QUIT_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_select_quit_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again1;
	}

	C2_ERROR_TIMES_RESET();
again2: 
	if((mkfifo(NOTIFY_SOCKET_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_notify_socket_fd = open(NOTIFY_SOCKET_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_notify_socket_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again2;
	}
	
int g_notify_fd=0;

	
C2_ERROR_TIMES_RESET();

again3: 
	if((mkfifo(NOTIFY_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_notify_fd = open(NOTIFY_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_notify_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again3;
	}


	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
uchar need_connect_now=0;

	while(1){
		int maxfd = 0;
		
		FD_ZERO(&select_fds); 
		if(g_select_quit_fd>0){
			FD_SET(g_select_quit_fd, &select_fds); 
			maxfd=MAX_(maxfd,g_select_quit_fd);
		}


		if(1 == connected){
			if(rx_need_wait){
				uint serial_time;
				struct timeval now;  
				gettimeofday(&now,NULL); 
				serial_time= timeval_subtract(&rx_need_wait_start,&now);
				if(serial_time>=rx_need_wait){
					rx_need_wait=0;
				}
				else{
					rx_need_wait=rx_need_wait-serial_time;
		TIM_DEBUG("in:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,rx_need_wait);
				}
//		TIM_ERROR("in:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,rx_need_wait);
			}
		
			if(0 == rx_need_wait){
				maxfd=MAX_(maxfd,sockfd);
				FD_SET(sockfd, &select_fds); 

				if(g_notify_fd>0){
					FD_SET(g_notify_fd, &select_fds); 
					maxfd=MAX_(maxfd,g_notify_fd);
				}
			}
			

		}
		
		if(g_notify_socket_fd>0){
			FD_SET(g_notify_socket_fd, &select_fds); 
			maxfd=MAX_(maxfd,g_notify_socket_fd);
		}
		
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

TIM_DEBUG("in:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,maxfd,select_fds);

		if((0 == connected)&&((C2_g_tcp_auto_connec)||(0 == remote_closed))){
			if((first_run == 1)||(need_connect_now)){
				first_run=0;
				tv.tv_sec = 0; 
				tv.tv_usec = 1; 
				need_connect_now=0;
			}
			else{
				tv.tv_sec = 0; 
				tv.tv_usec = 500*1000; 
			}
			ret = select(maxfd+1,&select_fds,NULL,NULL,&tv);
		}
		else{ 
			if(rx_need_wait){
				tv.tv_sec = rx_need_wait/1000000; 
				tv.tv_usec = rx_need_wait%1000000; 
				ret = select(maxfd+1,&select_fds,NULL,NULL,&tv);
			}
			else{
				ret = select(maxfd+1,&select_fds,NULL,NULL,NULL);
			}
		}
		if(ret>0){		
			if(0 == connected){
				need_connect_now=1;
			}
			if(FD_ISSET(g_notify_socket_fd,&select_fds)){
				uint x;
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				 x= read(g_notify_socket_fd, buf, sizeof(buf));
							
				uchar	   buf_serial[socket_buf_LEN];
				uint buf_serial_len=0;
				
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				if(connected == 0){
					TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
					remote_closed=0;
					continue;
				}
				
				C2_socket_buf_tx_(buf_serial,&buf_serial_len);
		//		statistics_serial_tx2 +=buf_serial_len;

	
				if(1 == C2_g_network_protocol){
					int sended=fd_write(sockfd, buf_serial, buf_serial_len);	 //!> 读出来的写进去
					if(sended < buf_serial_len){
					//	socket_buf_send((buf_serial+sended),(buf_serial_len-sended));
						
						TIM_WARN("warn:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,buf_serial_len,sended);
					}
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					
					TIM_DEBUG(":%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,buf_serial_len,sended);
				}
#if 0
				else if(2 == g_network_protocol){
					int sended=fd_write(sockfd, buf_serial, buf_serial_len);	 //!> 读出来的写进去
					if(sended < buf_serial_len){
					//	socket_buf_send((buf_serial+sended),(buf_serial_len-sended));
						
						TIM_WARN("warn:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,buf_serial_len,sended);
					}
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					
					TIM_DEBUG(":%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,buf_serial_len,sended);
				}
#endif
				else if(2 == C2_g_network_protocol){
					if(C2_udp_toAddr_p){
						if(buf_serial_len)
						if(sendto(sockfd,buf_serial,buf_serial_len,0,(struct sockaddr*)C2_udp_toAddr_p,sizeof(struct sockaddr))!=buf_serial_len){
							TIM_WARN("WARN:%s(%d)\r\n",__FUNCTION__,__LINE__);
							close(sockfd);
							sockfd=0;
							connected=0;
							led_set(0);
							C2_udp_toAddr_p=0;
						}
				
					}
				}
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	
			}
			
		if(0 == rx_need_wait)
			if(FD_ISSET(sockfd,&select_fds)||FD_ISSET( g_notify_fd, &select_fds )){
				uint lenx=C2_serial_buf_empty_len();
				if(FD_ISSET( g_notify_fd, &select_fds )){
					lenx=0;
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					 read(g_notify_fd, buf, sizeof(buf));
				}
				
				if(1 == C2_g_network_protocol){
					n = read(sockfd, buf, lenx);
				}
				else if(2 == C2_g_network_protocol){
					unsigned int addrLen;
					struct sockaddr_in udp_toAddr;

					addrLen = sizeof(struct sockaddr_in);
					if(lenx)
						n = recvfrom(sockfd,buf,lenx,0,(struct sockaddr*)&udp_toAddr,&addrLen);
					else
						n=0;
				}
				
				if( n< 0 ){
					TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
					connected=0;
					led_set(0);
					close(sockfd ); 	
					sockfd=0;
					continue;
				}
				else if( n == 0){
					if(lenx){
						TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
					//recv EOF .remote close the tcp connect.
						remote_closed=1;
						connected=0;
						led_set(0);
						close(sockfd ); 	
						sockfd=0;	
						continue;
					}
					else if(FD_ISSET( g_notify_fd, &select_fds )){
						buf[0]=0;
						TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					}
					else{
						buf[0]=0;
						//usleep(1000);
						rx_need_wait=C2_get_serial_wait_time();
//TIM_ERROR("w\r\n");
						gettimeofday(&rx_need_wait_start,NULL);
						TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					}
				}

				TIM_DEBUG("Client Recv: %d\n", n);

				TIM_DEBUG("Client send : %s\n", buf);
				//fd_write(g_serial_fd, buf, n);	 //!> 读出来的写进去
				C2_serial_buf_send(buf, n);
//				tim_all_len2+=n;
			}

			if(FD_ISSET(g_select_quit_fd,&select_fds)){
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				 read(g_select_quit_fd, buf, sizeof(buf));
				break;
			}
			
		}
		else if(ret == 0){
			TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
			
			if((0 != connected)&&(0 == rx_need_wait)){
				
				TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);

			}
							
			if((0 == connected)&&((C2_g_tcp_auto_connec)||(0 == remote_closed)))	{
				if((he=gethostbyname(C2_g_remoteip_domain))==NULL){
					TIM_ERROR("gethostbyname : %d(%s)\n", errno,strerror(errno));
					TIM_ERROR("ERROR:%s(%d) %s\r\n",__FUNCTION__,__LINE__,C2_g_remoteip_domain);
//					g_network_failed=1;
					goto out2;
				}
				
				if( (sockfd = socket( AF_INET, ((1 == C2_g_network_protocol)?SOCK_STREAM:(SOCK_DGRAM)), ((1 == C2_g_network_protocol)?0:(IPPROTO_UDP)) ) ) == -1 ){
					TIM_ERROR("Create socket Error : %d\n", errno );
					TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
//					g_network_failed=1;
					goto out2;
				}

if(C2_g_client_locale_port){
	
				{
					int on = 1;
					ret = setsockopt(sockfd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
					//ret = setsockopt(sockfd, SOL_SOCKET, SO_REUSEPORT, &on, sizeof(on));
					
				}

if(1 == C2_g_network_protocol){
	struct linger linger;
	linger.l_onoff = 1;
	linger.l_linger = 0;
	setsockopt(sockfd, SOL_SOCKET, SO_LINGER, (const char *) &linger,	  sizeof(linger));
}
				
				
	struct sockaddr_in servaddr;
	bzero(&servaddr, sizeof( servaddr ) );
	servaddr.sin_family = AF_INET;
	servaddr.sin_addr.s_addr  =htonl( INADDR_ANY);
	servaddr.sin_port = htons( C2_g_client_locale_port );
	
	 if( bind(sockfd, ( struct sockaddr * )&servaddr, sizeof(servaddr ) ) == -1 ){	
		TIM_ERROR("BindError : %d(%s)\n", errno,strerror(errno));
		TIM_ERROR("in:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,C2_g_client_locale_port);
		close(sockfd);
		C2_error_check_1s();
		sockfd=0;
		goto out2;
	 }
	 

}


				
				bzero(&their_addr, sizeof( their_addr ) );
				their_addr.sin_family = AF_INET;
				their_addr.sin_addr  =*((struct in_addr *)he->h_addr);
				their_addr.sin_port = htons( C2_g_locale_remote_port );
				
				   //add by ls for connect timeout bug	2004-10-26
				fcntl(sockfd,F_SETFL, O_NONBLOCK);	//文件描述词操作


if(1 == C2_g_network_protocol){				

{
	// 接收缓冲区
	int nRecvBuf=1024*4;		  //设置为32K
	setsockopt(sockfd,SOL_SOCKET,SO_RCVBUF,(const char*)&nRecvBuf,sizeof(int));
	//发送缓冲区
	int nSendBuf=1024*4;//设置为32K
	setsockopt(sockfd,SOL_SOCKET,SO_SNDBUF,(const char*)&nSendBuf,sizeof(int));


}
if(0)
{
	// 接收缓冲区
	struct  timeval timeout;
       timeout.tv_sec=1;
       timeout.tv_usec=0;  
	setsockopt(sockfd,SOL_SOCKET,SO_SNDTIMEO,(const char*)&timeout,sizeof(int));
	setsockopt(sockfd,SOL_SOCKET,SO_RCVTIMEO,(const char*)&timeout,sizeof(int));
}


