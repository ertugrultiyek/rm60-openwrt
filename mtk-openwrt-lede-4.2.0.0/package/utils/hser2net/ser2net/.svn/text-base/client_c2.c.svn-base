}

				
			if(1 == C2_g_network_protocol){	

				
				if(connect(sockfd,(struct sockaddr *)&their_addr,sizeof(struct sockaddr)) == -1) 
				{  
					if (errno == EINPROGRESS)  // it is in the connect process 
					{
						struct timeval tv; 
						fd_set writefds; 
						tv.tv_sec = 0; 
						tv.tv_usec = 500*1000; 
						FD_ZERO(&writefds); 
						FD_SET(sockfd, &writefds); 
						if(select(sockfd+1,NULL,&writefds,NULL,&tv)>0)
						{ 
							int error;
							int len=sizeof(int); 
							//下面的一句一定要，主要针对防火墙 
							getsockopt(sockfd, SOL_SOCKET, SO_ERROR, &error, &len); 
							if(error==0)	ret=0; 
							else  ret=1; 
						}
						else ret=1;//timeout or error happen 
					}
					else	ret=1; 
				} 
				else	ret=0; 
			}
			else if(2 == C2_g_network_protocol){
				bzero(&C2_toAddr, sizeof( C2_toAddr ) );
				C2_toAddr.sin_family = AF_INET;
				C2_toAddr.sin_addr  =*((struct in_addr *)he->h_addr);
				C2_toAddr.sin_port = htons( C2_g_locale_remote_port );
				C2_udp_toAddr_p=&C2_toAddr;
				ret=0;
			}

				if(ret){
					TIM_WARN("WARN:%s(%d)\r\n",__FUNCTION__,__LINE__);
					close(sockfd);
					connected=0;
					led_set(0);
				}
				else{
{
	int flags;
	flags = fcntl(sockfd,F_GETFL,0);
	fcntl(sockfd,F_SETFL,flags | O_NONBLOCK);
}
					connected=1;
					led_set(1);
					remote_closed=0;
					C2_ser2network_notify_socket();
				}
out2:			
			continue;

				
			}
			else {
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

				if(rx_need_wait){
					//will do in other place.
//TIM_ERROR("q\r\n");
				}

			}
		}
		else{
			TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
			static uchar x=0;
			static uint lasttime=0;
			if(lasttime){	  
				struct	timeval    tv;
				gettimeofday(&tv,NULL);
				if(lasttime == tv.tv_sec){
					x++;
					if(x>5){
						TIM_ERROR("ERROR:%s(%d)reboot\r\n",__FUNCTION__,__LINE__);
						system("(killall ser2net;killall -9 ser2net;sleep 1;ser2net)&");
						while(1)sleep(30);
					}
				}
				else{
					x=0;
				}
				lasttime=tv.tv_sec;
			}else{
				struct	timeval    tv;
				gettimeofday(&tv,NULL);
				lasttime=tv.tv_sec;
			}
		}
	}
		
out:
	if(sockfd){
		shutdown(sockfd,SHUT_RDWR);
		close(sockfd);
	}
	if(g_select_quit_fd)
		close(g_select_quit_fd);
	
	if(g_notify_fd)
		close(g_notify_fd);
	
	if(g_notify_socket_fd)
		close(g_notify_socket_fd);
	
//	pthread_exit(0);
	pthread_detach(pthread_self());
	return ((void*)0);

}

pthread_t C2_serial_thread_id;
pthread_t C2_server_thread_id;
pthread_t C2_client_thread_id;


int C2_init_()
{
	int res;
	
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
memset(&C2_serial_thread_id,0,sizeof(C2_serial_thread_id));
memset(&C2_server_thread_id,0,sizeof(C2_server_thread_id));
memset(&C2_client_thread_id,0,sizeof(C2_client_thread_id));

	
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
    res = pthread_mutex_init(&C2_serial_buf_mutex, NULL); //init mutex 初始化互斥锁
    if (res != 0)
    {
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	return -1;
    }
	
    res = pthread_mutex_init(&C2_socket_buf_mutex, NULL); //init mutex 初始化互斥锁
    if (res != 0)
    {
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	return -1;
    }

#if 0
	res = pthread_mutex_init(&C2_G_serial_mode_mutex, NULL); //init mutex 初始化互斥锁
	if (res != 0){
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	return -1;
    }


	if (pthread_mutex_init(&C2_g_mutex, NULL) != 0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		return -1;
	}
	
#endif

}




void C2_ser2network_server_thread_quit(uchar mode)
{
	int g_select_quit_fd;
	uchar buf[64];

	g_select_quit_fd = open(SERVER_QUIT_PIPE_DEV, O_RDWR|O_NONBLOCK);

	read(g_select_quit_fd, buf, sizeof(buf));

	if(0 == mode){
		write(g_select_quit_fd, "x", 1);
	}
	else{
		
	}

	close(g_select_quit_fd);
}


void C2_ser2network_client_thread_quit(uchar mode)
{
	int g_select_quit_fd;
	uchar buf[64];

	g_select_quit_fd = open(CLIENT_QUIT_PIPE_DEV, O_RDWR|O_NONBLOCK);

	read(g_select_quit_fd, buf, sizeof(buf));

	if(0 == mode){
		write(g_select_quit_fd, "x", 1);
	}
	else{
		
	}

//	hlk_check3();

	close(g_select_quit_fd);
}

void C2_ser2network_serial_thread_quit(uchar mode)
{
	int g_select_quit_fd;
	uchar buf[64];

	g_select_quit_fd = open(SERIAL_QUIT_PIPE_DEV, O_RDWR|O_NONBLOCK);

	read(g_select_quit_fd, buf, sizeof(buf));

	if(0 == mode){
		write(g_select_quit_fd, "x", 1);
	}
	else{
		
	}

	close(g_select_quit_fd);
}

uchar C2_config_do()

{
	pthread_t id;
	int i,ret;
	static uchar start_flags=0;

	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	C2_ser2network_server_thread_quit(0);
	C2_ser2network_client_thread_quit(0);
	C2_ser2network_serial_thread_quit(0);
//	ser2network_udp_thread_quit(0);

	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	usleep(200*1000);

	if(pthread_is_alive(C2_serial_thread_id)
		||pthread_is_alive(C2_server_thread_id)
		||pthread_is_alive(C2_client_thread_id)
//		||pthread_is_alive(C2_udp_thread_id)
		){
		
		usleep(500*1000);

		if(pthread_is_alive(C2_serial_thread_id)
			||pthread_is_alive(C2_server_thread_id)
			||pthread_is_alive(C2_client_thread_id)
//			||pthread_is_alive(udp_thread_id)
			){
			
			TIM_ERROR("ERROR:%s(%d)(%d)(%d)(%d)(%d)\r\n",__FUNCTION__,__LINE__,
				pthread_is_alive(C2_serial_thread_id),
				pthread_is_alive(C2_server_thread_id),
				pthread_is_alive(C2_client_thread_id),
0//				pthread_is_alive(udp_thread_id)
				);
			if(start_flags++>100){
				restart_app();
			}
			return 0;
		}
	}

	start_flags=0;


	C2_ser2network_server_thread_quit(1);
	C2_ser2network_client_thread_quit(1);
	C2_ser2network_serial_thread_quit(1);
//	ser2network_udp_thread_quit(1);


	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	ret=pthread_create(&C2_serial_thread_id,NULL,(void *) C2_serial_thread,NULL);

//	ret=pthread_create(&C2_udp_thread_id,NULL,(void *) udp_discovery_server,NULL);


	if(C2_G_serial_mode_get()){
		C2_G_serial_mode_set(1);
	}

//	if((g_network_failed)||(0 == g_network_mode)||(0 == g_network_protocol)){
	if((0 == C2_g_network_mode)||(0 == C2_g_network_protocol)){
//		ret=pthread_create(&id,NULL,(void *) ser2network_serial_at_thread,NULL);
//		g_network_failed=0;
		C2_G_serial_mode_set(1);
	}
	else if(1 == C2_g_network_mode){
		C2_G_serial_mode_set(0);
		ret=pthread_create(&C2_server_thread_id,NULL,(void *) C2_ser2network_server_thread,NULL);
	}
	else if(2 == C2_g_network_mode){
		C2_G_serial_mode_set(0);
		ret=pthread_create(&C2_client_thread_id,NULL,(void *) C2_ser2network_client_thread,NULL);
	}else{
//		ret=pthread_create(&id,NULL,(void *) ser2network_serial_at_thread,NULL);
	}
	
//	hlk_check1();

	return 1;

}
