void C2_ser2network_notify_serial()
{
	int g_select_quit_fd;

	g_select_quit_fd = open(NOTIFY_SERIAL_PIPE_DEV, O_RDWR|O_NONBLOCK);
{
	uchar buf[8];
	read(g_select_quit_fd, buf, sizeof(buf));
}
	write(g_select_quit_fd, "xxxx", 1);
	
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	close(g_select_quit_fd);
}

void C2_ser2network_notify_socket()
{
	int g_select_quit_fd;

	g_select_quit_fd = open(NOTIFY_SOCKET_PIPE_DEV, O_RDWR|O_NONBLOCK);
{
	uchar buf[8];
	read(g_select_quit_fd, buf, sizeof(buf));
}
	write(g_select_quit_fd, "xxxx", 1);

	close(g_select_quit_fd);
}








pthread_mutex_t C2_serial_buf_mutex;
pthread_mutex_t C2_socket_buf_mutex;


#define SERIAL_REQUEST() pthread_mutex_lock(&C2_serial_buf_mutex); 
#define SERIAL_RELEASE() pthread_mutex_unlock(&C2_serial_buf_mutex);

uchar C2_serial_buf_tx[SERIAL_BUF_LEN];
uchar *C2_serial_buf_tx_in=C2_serial_buf_tx;
uchar *C2_serial_buf_tx_out=C2_serial_buf_tx;

uchar C2_Serial_Flush_now=0;

uchar C2_serial_buf_empty_flush()
{
	SERIAL_REQUEST();
	C2_serial_buf_tx_out=C2_serial_buf_tx;
	C2_serial_buf_tx_in=C2_serial_buf_tx;
	SERIAL_RELEASE();

	C2_Serial_Flush_now=1;
	C2_ser2network_notify_serial();

	return 0;
}

uint C2_serial_buf_empty_len()
{
	uint len;
	
	if(C2_G_serial_mode_get()){
		return 0;
	}
	
	SERIAL_REQUEST();
TIM_DEBUG("in:%s(%d) %08x %08x \r\n",__FUNCTION__,__LINE__,C2_serial_buf_tx_out,C2_serial_buf_tx_in);
	if(C2_serial_buf_tx_out <= C2_serial_buf_tx_in){
		len = sizeof(C2_serial_buf_tx) - (C2_serial_buf_tx_in - C2_serial_buf_tx_out)-1;
	}
	else{
		len =C2_serial_buf_tx_out - C2_serial_buf_tx_in -1 ;
	}
	SERIAL_RELEASE();
	return len;
}


uchar C2_serial_buf_is_empty()
{
	uint ret;
	SERIAL_REQUEST();
	if(C2_serial_buf_tx_out != C2_serial_buf_tx_in){
		ret=0;
	}
	else
		ret=1;
	SERIAL_RELEASE();
	return ret;
}


uint C2_serial_buf_send(uchar *value,uint len)
{
	uint len_;
	SERIAL_REQUEST();
	if(C2_serial_buf_tx_out <= C2_serial_buf_tx_in){
		len_ = sizeof(C2_serial_buf_tx)  - (C2_serial_buf_tx_in - C2_serial_buf_tx_out)-1;
		if(len < len_)
			len_=len;

		if((C2_serial_buf_tx_in+len_)<(C2_serial_buf_tx+sizeof(C2_serial_buf_tx))){
			memcpy(C2_serial_buf_tx_in,value,len_);
			C2_serial_buf_tx_in +=len_;
		}
		else{
			uint len1;
			len1=(C2_serial_buf_tx+sizeof(C2_serial_buf_tx)) - C2_serial_buf_tx_in;
			memcpy(C2_serial_buf_tx_in,value,len1);
			memcpy(C2_serial_buf_tx,value+len1,len_-len1);
			C2_serial_buf_tx_in = C2_serial_buf_tx+(len_-len1);
		}
	}
	else{
		len_ =C2_serial_buf_tx_out - C2_serial_buf_tx_in -1 ;
		if(len < len_)
			len_=len;
		memcpy(C2_serial_buf_tx_in,value,len_);
		C2_serial_buf_tx_in +=len_;	
	}
	SERIAL_RELEASE();
	
TIM_DEBUG("in:%s(%d) %08x %08x \r\n",__FUNCTION__,__LINE__,C2_serial_buf_tx_out,C2_serial_buf_tx_in);
	C2_ser2network_notify_serial();
	
	if(0 == len)
		return 0;
	if(0 == C2_G_serial_mode_get())
		led_blink();
	return len;
}

uint C2_serial_buf_get(uchar *value,uint len)
{
	
	SERIAL_REQUEST();
	SERIAL_RELEASE();
	
	return 0;
}

uint C2_serial_buf_tx_(int fd)
{
	uint len;
	int iret=0;
	int ret;
	
TIM_DEBUG("in:%s(%d) %08x %08x \r\n",__FUNCTION__,__LINE__,C2_serial_buf_tx_out,C2_serial_buf_tx_in);
	SERIAL_REQUEST();
	if(C2_serial_buf_tx_out <= C2_serial_buf_tx_in){
TIM_DEBUG("in:%s(%d) %08x %08x \r\n",__FUNCTION__,__LINE__,C2_serial_buf_tx_out,C2_serial_buf_tx_in);
		len = (C2_serial_buf_tx_in - C2_serial_buf_tx_out);
		ret = write(fd, C2_serial_buf_tx_out, len);
		if(ret >= 0 ){				//O_NDELAY
			C2_serial_buf_tx_out += ret;
			
	//			statistics_serial_send +=ret;
		}
		else{
//			TIM_ERROR("ERROR:%s(%d)(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,len,ret,strerror(ret));
			iret = -1;
		}
	}
	else{
		int len1;
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
		len =sizeof(C2_serial_buf_tx)  - (C2_serial_buf_tx_out - C2_serial_buf_tx_in);
		len1 = ((C2_serial_buf_tx+sizeof(C2_serial_buf_tx))-C2_serial_buf_tx_out);
		ret = write(fd, C2_serial_buf_tx_out, len1);
		if(ret >= 0 ){				//O_NDELAY
			if(ret == len1){
				int len2;
				len2=(uint)C2_serial_buf_tx_in-(uint)C2_serial_buf_tx;

				ret = write(fd, C2_serial_buf_tx, len2);
				if(ret >= 0 ){				//O_NDELAY
					C2_serial_buf_tx_out=C2_serial_buf_tx+ret;
//					statistics_serial_send +=ret;
//					statistics_serial_send +=len1;
				}
				else{
//					TIM_ERROR("ERROR:%s(%d)(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,len,ret,strerror(ret));
					iret = -1;
					//serial_buf_tx_out += ret;
					C2_serial_buf_tx_out = C2_serial_buf_tx+0;
//					statistics_serial_send +=len1;
				}
			}
			else{
				C2_serial_buf_tx_out += ret;
//				statistics_serial_send +=ret;
			}
		}
		else{
//			TIM_ERROR("ERROR:%s(%d)(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,len,ret,strerror(ret));
			iret = -1;
		}
	}
	SERIAL_RELEASE();
	
	return iret;
}


#define SOCKET_REQUEST() pthread_mutex_lock(&C2_socket_buf_mutex); 
#define SOCKET_RELEASE() pthread_mutex_unlock(&C2_socket_buf_mutex);


uchar C2_socket_buf_tx[socket_buf_LEN];
uint C2_socket_buf_tx_in=(uint)C2_socket_buf_tx;
uint C2_socket_buf_tx_out=(uint)C2_socket_buf_tx;


uchar C2_socket_buf_empty_flush()
{
	SOCKET_REQUEST();
	C2_socket_buf_tx_out=(uint)C2_socket_buf_tx;
	C2_socket_buf_tx_in=(uint)C2_socket_buf_tx;
	SOCKET_RELEASE();
	return 0;
}

uint C2_socket_buf_empty_len()
{
	uint len;
	SOCKET_REQUEST();
	if(C2_socket_buf_tx_out <= C2_socket_buf_tx_in){
		len = socket_buf_LEN - (C2_socket_buf_tx_in - C2_socket_buf_tx_out)-1;
	}
	else{
		len =C2_socket_buf_tx_out - C2_socket_buf_tx_in -1 ;
	}
	SOCKET_RELEASE();
	return len;
}


uchar C2_socket_buf_is_empty()
{
	uint ret;
	SOCKET_REQUEST();
	if(C2_socket_buf_tx_out != C2_socket_buf_tx_in){
		ret=0;
	}
	else
		ret=1;
	SOCKET_RELEASE();
	return ret;
}


uint C2_socket_buf_send(uchar *value,uint len)
{
	uint len_;
	SOCKET_REQUEST();
	if(C2_socket_buf_tx_out <= C2_socket_buf_tx_in){
		len_ = socket_buf_LEN - (C2_socket_buf_tx_in - C2_socket_buf_tx_out)-1;
		if(len < len_)
			len_=len;

		if((C2_socket_buf_tx_in+len_)<((uint)C2_socket_buf_tx+sizeof(C2_socket_buf_tx))){
			memcpy((void *)C2_socket_buf_tx_in,value,len_);
			C2_socket_buf_tx_in +=len_;
		}
		else{
			uint len1;
			len1=((uint)C2_socket_buf_tx+sizeof(C2_socket_buf_tx)) - C2_socket_buf_tx_in;
			memcpy((void *)C2_socket_buf_tx_in,value,len1);
			memcpy(C2_socket_buf_tx,value+len1,len_-len1);
			C2_socket_buf_tx_in = (uint)C2_socket_buf_tx+(len_-len1);
		}
	}
	else{
		len_ =C2_socket_buf_tx_out - C2_socket_buf_tx_in -1 ;
		if(len < len_)
			len_=len;
		memcpy((void *)C2_socket_buf_tx_in,value,len_);
		C2_socket_buf_tx_in +=len_;	
	}
	SOCKET_RELEASE();
	C2_ser2network_notify_socket();
	led_blink();
}

uint C2_socket_buf_get(uchar *value,uint len)
{
	
	SOCKET_REQUEST();
	SOCKET_RELEASE();
}

uint C2_socket_buf_tx_(uchar *buf,uint *len_)
{
	uint len;
	int iret=0;
	int ret;
	
	SOCKET_REQUEST();
	if(C2_socket_buf_tx_out <= C2_socket_buf_tx_in){
		len = (C2_socket_buf_tx_in - C2_socket_buf_tx_out);
//		ret = write(fd, socket_buf_tx_out, len);
		memcpy(buf,(void *)C2_socket_buf_tx_out, len);buf+=len;ret=len;
		

		if(ret >= 0 ){				//O_NDELAY
			C2_socket_buf_tx_out += ret;
		}
		else{
			TIM_ERROR("ERROR:%s(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,ret,strerror(ret));
			iret = -1;
		}
	}
	else{
		int len1;
		len =socket_buf_LEN - (C2_socket_buf_tx_out - C2_socket_buf_tx_in);
		len1 = (((uint)C2_socket_buf_tx+sizeof(C2_socket_buf_tx))-C2_socket_buf_tx_out);
//		ret = write(fd, socket_buf_tx_out, len1);

		memcpy(buf,(void *)C2_socket_buf_tx_out, len1);buf+=len1;ret=len1;


		if(ret >= 0 ){				//O_NDELAY
			if(ret == len1){
				int len2;
				len2=C2_socket_buf_tx_in-(uint)C2_socket_buf_tx;

//				ret = write(fd, socket_buf_tx, len2);		
				memcpy(buf,C2_socket_buf_tx, len2);buf+=len2;ret=len2;
				if(ret >= 0 ){				//O_NDELAY
					C2_socket_buf_tx_out=(uint)C2_socket_buf_tx+ret;
				}
				else{
					TIM_ERROR("ERROR:%s(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,ret,strerror(ret));
					iret = -1;
					C2_socket_buf_tx_out += ret;
				}
			}
			else{
				C2_socket_buf_tx_out += ret;
			}
		}
		else{
			TIM_ERROR("ERROR:%s(%d)(%d)(%s)\r\n",__FUNCTION__,__LINE__,ret,strerror(ret));
			iret = -1;
		}
	}
	SOCKET_RELEASE();
	*len_=len;
	return iret;
}


int C2_serial_set_speci_baud(int fd,int baud)
{
    struct serial_struct ss,ss_set;
	
	tcgetattr(fd,&C2_options);   

    cfsetispeed(&C2_options,B38400);
    cfsetospeed(&C2_options,B38400);

    tcflush(fd,TCIFLUSH);/*handle unrecevie char*/
    tcsetattr(fd,TCSANOW,&C2_options);

    if((ioctl(fd,TIOCGSERIAL,&ss))<0){
        TIM_ERROR("BAUD: error to get the serial_struct info:%s\r\n",strerror(errno));
        return -1;
    }

    ss.flags = ASYNC_SPD_CUST;
    ss.custom_divisor = ss.baud_base / baud;
	
//    ss.custom_divisor = 40000000/16 / baud;
    ss.custom_divisor = 22;
{
	unsigned int x=40000000*10/16 /baud;
	ss.custom_divisor = x/10;
	if((x%10)>4)
		ss.custom_divisor++;
}

	
TIM_ERROR("In:%s(%d) (%d)(%d)\r\n",__FUNCTION__,__LINE__,
baud, ss.custom_divisor );


    if((ioctl(fd,TIOCSSERIAL,&ss))<0){
        TIM_ERROR("BAUD: error to set serial_struct:%s\r\n",strerror(errno));
        return -2;
    }

    ioctl(fd,TIOCGSERIAL,&ss_set);
    TIM_ERROR("BAUD: success set baud to %d,custom_divisor=%d,baud_base=%d\r\n",
            baud,ss_set.custom_divisor,ss_set.baud_base);

    return 0;
}


//"115200,8,n,1"
int C2_Serial_Config(int fd,uchar *para)
{

	speed_t speed;

	int Baud=115200;
	uchar Data_size=8;
	uchar parity='n';
	uchar stop_bit=1;

if(fd<0){
	TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);	
}
	
{
	uchar *p1,*p2;

p1=para;

if(p1){
	Baud=atoi(p1);
	p2 = strchr(p1,',');
	if(p2){
		p1=(p2+1);
		Data_size=atoi(p1);
		p2 = strchr(p1,',');
		if(p2){
			p1=(p2+1);
			parity=*p1;
			
			p2 = strchr(p1,',');
			if(p2){
				p1=(p2+1);
				stop_bit=atoi(p1);
			}
		}
	}
}


}

	TIM_DEBUG("In:%s(%d) (%d)(%d)(%c)(%d)\r\n",__FUNCTION__,__LINE__,
		Baud,Data_size,parity,stop_bit);

	tcgetattr(fd,&C2_oldtio);
    	tcgetattr(fd,&C2_options);   

//	TIM_DEBUG("In:%s(%d)(%d)(%d)\r\n",__FUNCTION__,__LINE__,cfgetospeed(&options),cfgetospeed(&oldtio));

   	fcntl(fd,F_SETFL,0);
	fcntl(fd,F_SETFL,FNDELAY) ;
   	
	//options.c_cflag&=~PARENB;
	//options.c_cflag&=~CSTOPB;
	//options.c_cflag&=~CSIZE;
	//options.c_cflag|=CS8;
	//options.c_lflag=0;
	//options.c_oflag&=(~OPOST);
	//options.c_cflag|=(CLOCAL|CREAD);
	//options.c_cc[VTIME]    = 20;  /* inter-character timer use 2s */
	//options.c_cc[VMIN]     = 0;   /* blocking read until 1 chars received */

       //Add by Ls 20031115   以原始流的方式打开串口,不做任何其他转化
	//options.c_lflag  &= ~(ICANON | ECHO | ECHOE | ISIG);  /*Input*/
	//options.c_oflag  &= ~OPOST;   /*Output*/

	C2_options.c_iflag = 0;
	C2_options.c_oflag = 0;
	C2_options.c_lflag = 0;
	if(0==0)  
		C2_options.c_cc[VTIME]    = 20;
	else  
		C2_options.c_cc[VTIME]    = 0;//20;  //inter-character timer use 2s 
//	options.c_cc[VTIME]    = 20;
	C2_options.c_cc[VMIN]     = 0;   //blocking read until 1 chars received 
	C2_options.c_cflag = CS8 | CLOCAL | CREAD;


	
if(5 == Data_size){
	C2_options.c_cflag &= ~CSIZE;
	C2_options.c_cflag |= CS5;

}
else if(6 == Data_size){
	C2_options.c_cflag &= ~CSIZE;
	C2_options.c_cflag |= CS6;

}
else if(7 == Data_size){
	C2_options.c_cflag &= ~CSIZE;
	C2_options.c_cflag |= CS7;

}
else if(8 == Data_size){
	
	C2_options.c_cflag &= ~CSIZE;
	C2_options.c_cflag |= CS8;

}


if('n' == parity){

}
else if('o' == parity){
	
	C2_options.c_cflag |= PARENB;
	C2_options.c_cflag |= PARODD;
//	options.c_iflag |= (INPCK | ISTRIP);
	C2_options.c_iflag |= (INPCK);

}
else if('e' == parity){
	C2_options.c_cflag |= PARENB;
	C2_options.c_cflag &= ~PARODD;
//	options.c_iflag |= (INPCK | ISTRIP);
	C2_options.c_iflag |= (INPCK );
//	options.c_iflag |= (ISTRIP );


}

	
if(1 == stop_bit){
	C2_options.c_cflag &= ~CSTOPB;
}
else if(2 == stop_bit){
	C2_options.c_cflag |= CSTOPB;
}
else {
	C2_options.c_cflag |= CSTOPB;
}


TIM_WARN("In:%s(%d)(%08x)(%d)\r\n",__FUNCTION__,__LINE__,C2_options.c_cflag,cfgetospeed(&C2_oldtio));

#if 1
//C2_FLOW_CONTROL_=1;

if(C2_FLOW_CONTROL_){
	C2_options.c_cflag |= CRTSCTS;
//	options.c_cc[]     = 1;


}
else{
	C2_options.c_cflag &= ~CRTSCTS;
//	options.c_cc[CIBAUD]     = 0;


}
#endif
TIM_WARN("In:%s(%d)(%08x)(%d)\r\n",__FUNCTION__,__LINE__,C2_options.c_cflag,cfgetospeed(&C2_oldtio));

	switch(Baud){
		case 50:
			speed=B50;
			break;
		case 75:
			speed=B75;
			break;
		case 110:
			speed=B110;
			break;
		case 134:
			speed=B134;
			break;
		case 150:
			speed=B150;
			break;
		case 200:
			speed=B200;
			break;
		case 300:
			speed=B300;
			break;
		case 600:
			speed=B600;
			break;
		case 1200:
			speed=B1200;
			break;
		case 1800:
			speed=B1800;
			break;
		case 2400:
			speed=B2400;
			break;
		case 4800:
			speed=B4800;
			break;
		case 9600:
			speed=B9600;
			break;
		case 19200:
			speed=B19200;
			break;
		case 38400:
			speed=B38400;
			break;
		case 57600:
			speed=B57600;
			break;
		case 115200:
			speed=B115200;
			break;
		case 230400:
			speed=B230400;
			break;
		default:
			speed=B115200;
			TIM_WARN("WARN:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,Baud);
			break;
	}
	
	TIM_WARN("in:%s(%d) %d %d %d\r\n",__FUNCTION__,__LINE__,B115200,speed,B57600);

//	TIM_DEBUG(":%s(%d)(%d)(%d)\r\n",__FUNCTION__,__LINE__,cfgetospeed(&options),cfgetospeed(&oldtio));

if(C2_XON_XOFF){
	C2_options.c_iflag  |= IXON;
	C2_options.c_iflag  |= IXOFF;
}


	
//	cfsetospeed(&options,speed);
//	cfsetispeed(&options,speed);
	if(cfsetispeed(&C2_options,speed)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	
	if(cfsetispeed(&C2_options,speed)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	

	if(tcsetattr(fd,TCSAFLUSH,&C2_options)){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}	

	tcflush(fd,TCIOFLUSH); 

	C2_serial_set_speci_baud(fd,Baud);

	
	return 0;
}

uint C2_get_serial_wait_time()	//us
{
	int Baud=115200;
	uchar Data_size=8;
	uchar parity='n';
	uchar stop_bit=1;

	uint time;

{
	uchar *p1,*p2;

	p1=C2_g_serial_config;

	if(p1){
		Baud=atoi(p1);
	}
}

#define SERIAL_WAITETIME_LEN 4*1024/10		//  1/5

	time=1000000*(SERIAL_WAITETIME_LEN)/Baud;
	TIM_DEBUG("in:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,time);
//	time=1000;
	return time;

}

void *  C2_serial_thread(void * arg)
{
	int ret;
	uchar	   buf[COMM_BUF_LEN];			
	uchar	   buf_serial[SERIAL_BUF_LEN];	
	uint buf_serial_len=0;

	struct timeval tv;  
	fd_set select_fds;
	
	int g_serial_fd=0;
	int g_select_quit_fd=0;
	int g_notify_serial_fd=0;
	uchar serial_opened=0;
	
	uint tx_wait_time=0;	//us
	uint serial_timeout=0;	//us
	uint serial_interval_timeout=0;	//us
	
	struct timeval serial_timeout_start;
	struct timeval serial_interval_timeout_start;
	
	
	
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	
	if((mkfifo(SERIAL_QUIT_PIPE_DEV, 0777) < 0) && (errno != EEXIST)){
		TIM_DEBUG("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}

	g_select_quit_fd = open(SERIAL_QUIT_PIPE_DEV, O_NONBLOCK | O_RDWR);
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	if(g_select_quit_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		restart_app();
	}	
			
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	
	if((mkfifo(NOTIFY_SERIAL_PIPE_DEV, 0777) < 0) && (errno != EEXIST)){
		TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}

	g_notify_serial_fd = open(NOTIFY_SERIAL_PIPE_DEV, O_NONBLOCK | O_RDWR);
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	if(g_notify_serial_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		restart_app();
	}	

			
	while(1){
		int maxfd = 0;
		uchar time_need=0;

TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);	

		FD_ZERO(&select_fds); 
		
		if(serial_opened){
			if(g_serial_fd){
				FD_SET(g_serial_fd, &select_fds); 
				maxfd=MAX_(maxfd,g_serial_fd);
			}
			else{
				TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
			}
		}
		
		FD_SET(g_select_quit_fd, &select_fds); 
		maxfd=MAX_(maxfd,g_select_quit_fd);
		
		FD_SET(g_notify_serial_fd, &select_fds); 
		maxfd=MAX_(maxfd,g_notify_serial_fd);


		if(0 == serial_opened){
#if 1
{
			TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
							
			TIM_ERROR("g\r\n");
			g_serial_fd=open(UART_DEV,O_RDWR|O_NOCTTY|O_NDELAY);	
			if(g_serial_fd<0){
				TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
			}
			else{
				C2_Serial_Config(g_serial_fd,C2_g_serial_config);
				serial_opened=1;
			}
}
#endif
			
			tv.tv_sec = 500/1000; 
			tv.tv_usec = (500%1000)*1000; 
			time_need=1;
		}
		else{
{
	uint serial_time=0;

	tx_wait_time=0;
	if(0 == C2_serial_buf_is_empty()){
		C2_serial_buf_tx_(g_serial_fd);
		if(0 == C2_serial_buf_is_empty()){
			tx_wait_time=C2_get_serial_wait_time();
		}
	}

	if(serial_timeout||serial_interval_timeout){
		uint serial_time1=0xfffffff;
		uint serial_time2=0xfffffff;
		struct timeval now;  
		gettimeofday(&now,NULL); 
		if(serial_timeout){
			serial_time1 = timeval_subtract(&serial_timeout_start,&now);
			if(serial_time1>=serial_timeout)
				serial_time1=1;
			else
				serial_time1=serial_timeout-serial_time1;
		}
		if(serial_interval_timeout){
			serial_time2 = timeval_subtract(&serial_interval_timeout_start,&now);
			if(serial_time2>=serial_interval_timeout)
				serial_time2=1;
			else
				serial_time2=serial_interval_timeout-serial_time2;
		}
		serial_time=MIN_(serial_time1,serial_time2);
	}
	
	if(tx_wait_time ||serial_time){
		uint t;
		if(tx_wait_time>serial_time){
			if(serial_time){
				t=serial_time;
				time_need=2;
			}
			else {
				t=tx_wait_time;
				time_need=3;
			}
		}
		else{
			if(tx_wait_time){
				t=tx_wait_time;
				time_need=3;
			}
			else {
				t=serial_time;
				time_need=2;
			}
		}
		
TIM_DEBUG("in:%s(%d) %d \r\n",__FUNCTION__,__LINE__,t);
		tv.tv_sec = t/1000000; 
		tv.tv_usec = t%1000000; 

	}
}
		}

TIM_DEBUG("in:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,maxfd,select_fds);
		if(time_need){
			ret = select(maxfd+1,&select_fds,NULL,NULL,&tv);
		}
		else{
			ret = select(maxfd+1,&select_fds,NULL,NULL,NULL);
		}
		if(ret>0){		

			if(FD_ISSET(g_notify_serial_fd,&select_fds)){
				uint x;
				uchar buf1[64];
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				 x= read(g_notify_serial_fd, buf1, sizeof(buf1));
				TIM_DEBUG("in:%s(%d) (%d)\r\n",__FUNCTION__,__LINE__,x);

				if(C2_Serial_Flush_now){
					C2_Serial_Flush_now=0;
					
					if(serial_opened){
						if(g_serial_fd)
							tcflush(g_serial_fd,TCOFLUSH);
					}
				}
				else{
					C2_serial_buf_tx_(g_serial_fd);
				}
//			TIM_ERROR("g\r\n");
			}
			
			if(FD_ISSET(g_select_quit_fd,&select_fds)){
				TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				 read(g_select_quit_fd, buf, sizeof(buf));
				break;
			}

			
			if(FD_ISSET(g_serial_fd,&select_fds)){
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				if(C2_G_serial_mode_get()){
					uint z;
					z=read(g_serial_fd, &buf_serial[buf_serial_len], 1);

					if(1 == z){

						if((0x00 == buf_serial[buf_serial_len])
							||(0x0a == buf_serial[buf_serial_len])){
							continue;
						}
						
						buf_serial_len += z ;

						if(buf_serial_len>=sizeof(buf)){
							TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
							buf_serial_len=0;
							C2_serial_buf_send("\r\nERROR:command too long!\r\n", sizeof("\r\nERROR:command too long!\r\n"));
							continue;
						}
						
						//fd_write(g_serial_fd, &buf_serial[buf_serial_len-1], 1);
						C2_serial_buf_send(&buf_serial[buf_serial_len-1], 1);
							
						if('\r' == buf_serial[buf_serial_len-1]){
							buf_serial[buf_serial_len-1]=0;
							//at(buf_serial,buf);
							buf[0]=0;
						if(buf_serial[0])
							//C2_config_command(buf_serial,buf);
							buf[sizeof(buf)-1]=0;
							//fd_write(g_serial_fd, "\n", 1);
							C2_serial_buf_send("\r\n", 2);
							//fd_write(g_serial_fd, buf, strlen(buf));	 //!> 读出来的写进去
							C2_serial_buf_send(buf, strlen(buf));
							C2_serial_buf_send("\r\n", 2);
							buf_serial_len=0;

						}
					}
					else{
						TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
						buf_serial_len=0;
					}
				}
//				else if(G_serial_mode_get()){
				else{
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					uint z;
					z=read(g_serial_fd, &buf_serial[buf_serial_len], MIN_(C2_g_serial_package_len,sizeof(buf_serial)-buf_serial_len));
					if(0 == buf_serial_len){
						uint x=get_serial_wait_time2(z);
						uint y=C2_g_serial_package_time*1000;
						if(y>x){
							serial_timeout=y-x;
						}
						else{
							serial_timeout=1;
						}
						gettimeofday(&serial_timeout_start,NULL);
					}
					serial_interval_timeout=C2_g_serial_package_interval_time*1000;
					gettimeofday(&serial_interval_timeout_start,NULL);
//TIM_ERROR("in:%s(%d)  %d\r\n",__FUNCTION__,__LINE__,z);
//TIM_ERROR("in:%s(%d)  %d\r\n",__FUNCTION__,__LINE__,g_transparent_escape_en);
#if 0
					if(1 == g_transparent_escape_en){
						if(1 == z)
							out_transparent(buf_serial[buf_serial_len]);
						else
							out_transparent(0xff);
					}

					
					if(1 == g_transparent_escape2_en){
						if(3 == z)
							out_transparent2(&buf_serial[buf_serial_len],z);
						else
							out_transparent2(0,0);
					}
#endif
						
					buf_serial_len += z ;

	TIM_DEBUG("in:%s(%d)  %d\r\n",__FUNCTION__,__LINE__,buf_serial_len);
	TIM_DEBUG("in:%s(%d)  %d\r\n",__FUNCTION__,__LINE__,C2_g_serial_package_len);

					if((buf_serial_len >= MIN_(C2_g_serial_package_len,sizeof(buf_serial)))
						||(serial_timeout==0)||(serial_interval_timeout==0)){

						TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
						C2_socket_buf_send(buf_serial, buf_serial_len);	
			//			statistics_serial_tx+=buf_serial_len;
						TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

						buf_serial_len=0;
						serial_timeout=0;
						serial_interval_timeout=0;
					}
					else {

{
	
	uint serial_time;
//	struct timeval now;  
//	gettimeofday(&now,NULL); 
	{
		serial_time= timeval_subtract2(&serial_timeout_start,&serial_interval_timeout_start);
		if(serial_time>=serial_timeout){
			TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
			C2_socket_buf_send(buf_serial, buf_serial_len);
	//		statistics_serial_tx+=buf_serial_len;			
			TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
		
			buf_serial_len=0;
			serial_timeout=0;
			serial_interval_timeout=0;

//			sleep(1);
		}
	}
}

}
				}
			}

			
		}
		else if(ret == 0){
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);


			if((0 != serial_opened)
				&&(0 == tx_wait_time)
				&&(0 == serial_timeout)
				&&(0 == serial_interval_timeout)){
				
				TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);

			}
			
//			TIM_ERROR("h%d\r\n",serial_opened);

			if(0 == serial_opened){
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				
//TIM_ERROR("g\r\n");
				g_serial_fd=open(UART_DEV,O_RDWR|O_NOCTTY|O_NDELAY);	
				if(g_serial_fd<0){
					TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
				}
				else{
					C2_Serial_Config(g_serial_fd,C2_g_serial_config);
					serial_opened=1;
				}
			}else{

				if(0 == C2_serial_buf_is_empty()){
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
					C2_serial_buf_tx_(g_serial_fd);
				}
				
				if(serial_timeout||serial_interval_timeout){
					uint serial_time;
					struct timeval now;  
					gettimeofday(&now,NULL); 
					if(serial_timeout){
						serial_time= timeval_subtract(&serial_timeout_start,&now);
						if(serial_time>=serial_timeout){
							TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
							C2_socket_buf_send(buf_serial, buf_serial_len);
//							statistics_serial_tx+=buf_serial_len;			
							TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
						
							buf_serial_len=0;
							serial_timeout=0;
							serial_interval_timeout=0;
						}
					}
					if(buf_serial_len && serial_interval_timeout){
						
						serial_time= timeval_subtract(&serial_interval_timeout_start,&now);
						if(serial_time>=serial_interval_timeout){
							TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
							C2_socket_buf_send(buf_serial, buf_serial_len);
//							statistics_serial_tx+=buf_serial_len;			
							TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
						
							buf_serial_len=0;
							serial_timeout=0;
							serial_interval_timeout=0;
						}
					}
					TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
				}

			}

			
			continue;
		}
		else{
			TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		}
	}

	if(g_serial_fd>0)
		close(g_serial_fd);
	
	if(g_notify_serial_fd>0){
		close(g_notify_serial_fd);
		TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
	}
	
	if(g_select_quit_fd>0)
		close(g_select_quit_fd);

//	pthread_exit(0);
	pthread_detach(pthread_self());
	return ((void*)0);

		
}


uint C2_error_times=0;
#define MAX_ERROR_TIMES 10

void C2_ERROR_TIMES_RESET()
{
	C2_error_times=0;
}

void C2_ERROR_TIMES_AGAIN()
{
	if(C2_error_times++ >MAX_ERROR_TIMES){
		restart_app();
	}
}

void C2_led_tcp_check(int *client)
{
#if 1
	int i;
	uchar found=0;
	for(i=0;i<MAX_CONNECTS;i++){
		if(client[i]!=(-1)){
			found=1;
			break;
		}
	}
	led_set(found);
#endif
}

						
void C2_error_check_1s()
{
	struct	timeval    tv;
	static struct  timeval	  tv_last={0,0};

	static uchar count=0;
	uint i;

	gettimeofday(&tv,NULL);

	i=timeval_subtract(&tv_last,&tv);
	if((i<(1000*1000))
				&&(tv_last.tv_sec)
				&&(tv_last.tv_usec)){
		count++;
		if(count > 20){
			if(0==G_serial_mode_get()){
TIM_ERROR("ERROR!!!!:%s(%d)\r\n",__FUNCTION__,__LINE__);
				restart_app();
			}
		}
	}
	else{
		count=0;
	}
	gettimeofday(&tv_last,NULL);
}

void * C2_ser2network_server_thread(void * arg)
{
	uchar first_run=1;
	uchar listened=0;
	int ret;

	uint rx_need_wait=0;
	struct timeval rx_need_wait_start; 
	
	int g_select_quit_fd=0;
	int g_notify_socket_fd=0;
	
	struct timeval tv; 
	fd_set select_fds;

	int 		 listenfd=0,connfd=0, sockfd=0, maxfd, maxi, i;
	int		  nready,client[MAX_CONNECTS];	   //!> 接收select返回值、保存客户端套接字
	int		  lens;
	socklen_t	clilen;
	struct sockaddr_in servaddr, chiaddr;

	ssize_t   n;			 //!> read字节数
	uchar	   buf[SERIAL_BUF_LEN];			
//	uchar	   buf_serial[SERIAL_BUF_LEN];	
//	uint buf_serial_len=0;

	uint client_tick[MAX_CONNECTS];

//	uint serial_timeout=0;
	
	led_set(0);


	C2_ERROR_TIMES_RESET();

again1:	
	if((mkfifo(SERVER_QUIT_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_select_quit_fd = open(SERVER_QUIT_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_select_quit_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again1;
	}

	C2_ERROR_TIMES_RESET();

again2:	
	if((mkfifo(NOTIFY_SOCKET_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_notify_socket_fd = open(NOTIFY_SOCKET_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_notify_socket_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again2;
	}



int g_notify_fd=0;

	
C2_ERROR_TIMES_RESET();

again3: 
	if((mkfifo(NOTIFY_PIPE_DEV, 0777) < 0) && (errno != EEXIST))
	{
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
	//			exit(1);
	}

	g_notify_fd = open(NOTIFY_PIPE_DEV, O_NONBLOCK | O_RDWR);
	if(g_notify_fd<=0){
		TIM_ERROR("ERROR:%s(%d)\r\n",__FUNCTION__,__LINE__);
		C2_ERROR_TIMES_AGAIN();
		usleep(50*1000);
		goto again3;
	}


	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

out1:
   
	for( i = 0;i < MAX_CONNECTS; i++)  {
		client[i] =-1;      
	}
	
	TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);

	while(1){
		int maxfd = 0;
		
		FD_ZERO(&select_fds); 
		
		if(g_select_quit_fd>0){
			FD_SET(g_select_quit_fd, &select_fds); 
			maxfd=MAX_(maxfd,g_select_quit_fd);
		}


		if(1==listened){
			FD_SET(listenfd, &select_fds); 
			maxfd=MAX_(maxfd,listenfd);
		}


		if(rx_need_wait){
			uint serial_time;
			struct timeval now;  
			gettimeofday(&now,NULL); 
			serial_time= timeval_subtract(&rx_need_wait_start,&now);
			if(serial_time>=rx_need_wait){
				rx_need_wait=0;
			}
			else{
				rx_need_wait=rx_need_wait-serial_time;
	TIM_DEBUG("in:%s(%d)(%d)\r\n",__FUNCTION__,__LINE__,rx_need_wait);
			}
		}
		

		if(0 == rx_need_wait){
			uchar have_connect=0;
			for( i = 0;i < MAX_CONNECTS; i++)	
			{
			   if(client[i]>0){
				FD_SET(client[i], &select_fds); 
				maxfd=MAX_(maxfd,client[i]);
				have_connect=1;
			   }
			}
			if(have_connect)
				if(g_notify_fd>0){
					FD_SET(g_notify_fd, &select_fds); 
					maxfd=MAX_(maxfd,g_notify_fd);
				}

		}
		
TIM_DEBUG("in:%s(%d)\r\n",__FUNCTION__,__LINE__);
TIM_DEBUG("in:%s(%d) %d %d\r\n",__FUNCTION__,__LINE__,maxfd,select_fds);

		if(0 == listened){
			if(first_run == 1){
				first_run=0;
				tv.tv_sec = 0; 
				tv.tv_usec = 1; 
			}
			else{
				tv.tv_sec = 0; 
				tv.tv_usec = 500*1000; 
			}
			ret = select(maxfd+1,&select_fds,NULL,NULL,&tv);
		}
		else{

			if(g_notify_socket_fd>0){
				FD_SET(g_notify_socket_fd, &select_fds); 
				maxfd=MAX_(maxfd,g_notify_socket_fd);
			}
			
			if(rx_need_wait){
				tv.tv_sec = rx_need_wait/1000000; 
				tv.tv_usec = rx_need_wait%1000000; 
				ret = select(maxfd+1,&select_fds,NULL,NULL,&tv);
			}
			else{
				ret = select(maxfd+1,&select_fds,NULL,NULL,NULL);
			}
		}
		if(ret>0){ 		
